{
  "name": "leemos-backend",
  "version": "1.0.0",
  "description": "Leemos API server (Express + Drizzle + OpenAI).",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --watch . --ext ts --exec \"ts-node --project tsconfig.json server.ts\"",
    "start": "ts-node --project tsconfig.json server.ts",
    "db:push": "ts-node db/push.ts",
    "db:enter": "ts-node db/enter.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "openai": "^6.39.1",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
